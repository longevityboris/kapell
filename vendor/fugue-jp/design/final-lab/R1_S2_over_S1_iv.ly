\version "2.24.0"
% L12 (resource, 2 voices only): S2 in full over S1 in the SUBDOMINANT (E-flat minor) in the bass, starting together.
% The bass subject's E-flat turns S2's opening C-A-F into V4/2; the bass's neighbour D makes V/iv (B-flat major 6)
% under S2's B-flat. Not used in the skeleton; available to the composer as a full-length S1+S2 combination.
% Known issue: S2's D-flat (1:4) against the bass's D natural half a beat later is a false relation.
soprano = \absolute {
  c''4. a'8 f'4 des''8 bes'8 | c''2. f''8 bes'8 | ees''4. des''8 des''4. c''8 | c''1 | r1 |
}
alto = \absolute {
  R1*5 |
}
tenor = \absolute {
  R1*5 |
}
bass = \absolute {
  ees,2. ees,8 d,8 | ees,2. ees,8 d,8 | ees,4. f,8 f,4. aes,8 | aes,2. ges,8 ees,8 | f,4. d,8 bes,4 r4 |
}
