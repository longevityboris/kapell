 },
 "assignments": [
  {"voice": "soprano", "part": "vn1"},
  {"voice": "alto", "part": "vn2"},
  {"voice": "tenor", "part": "va"},
  {"voice": "bass", "part": "vc"},
  {"voice": "soprano", "part": "fl", "at": "5:1", "octave": 12, "level": -0.5},
  {"voice": "bass", "part": "hn", "at": "5:1", "octave": 12, "level": -1},
  {"voice": "soprano", "part": "soprano", "at": "3:1"},
  {"voice": "alto", "part": "alto", "at": "3:1"},
